{
  "name": "@termix-it/platform-sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the TermiX (AACP) marketplace platform API — a business-flow wrapper, not a thin HTTP client.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example:read": "tsx examples/read-loop.ts",
    "example:demo": "tsx examples/demo.ts",
    "example:client-buy": "tsx examples/client-buy.ts",
    "example:provider-publish": "tsx examples/provider-publish.ts",
    "example:negotiate": "tsx examples/negotiate-offer.ts",
    "example:signing": "tsx examples/signing-modes.ts",
    "example:realtime": "tsx examples/realtime.ts",
    "gen:types": "tsx scripts/gen-types.ts"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "viem": "^2.57.4",
    "vitest": "^1.6.0",
    "zod-to-json-schema": "^3.23.0"
  }
}
